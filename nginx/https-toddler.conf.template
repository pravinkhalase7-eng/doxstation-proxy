# HTTPS for toddler.doxstation.com — written at container start if the cert exists.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name toddler.doxstation.com;
    client_max_body_size 20m;

    ssl_certificate     /etc/letsencrypt/live/toddler.doxstation.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toddler.doxstation.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://toddler_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
}
