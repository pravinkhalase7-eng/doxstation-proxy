# Copy to .env on the VPS. Do not commit .env.
IMAGE_TAG=latest

# Host ports. Leave these at 80 and 443 only on the machine that should own public ingress.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# AI Code Player is reached through the ports its own Compose project publishes.
NGINX_SERVER_NAME=play.doxstation.com
WEB_HOST_PORT=3010
API_HOST_PORT=8010
